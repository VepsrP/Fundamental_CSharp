                            <Button x:Name="OfflineAccelerate" 
                                   Content="Accelerate" 
                                   Style="{StaticResource HollowButton}"/>
                            <Button x:Name="OfflineDeaccelerate" 
                                   Content="Deaccelerate" 
                                   Style="{StaticResource HollowButton}"
                                   Margin="10,0,0,0"/>
                            <Button x:Name="OfflineCancel" 
                                   Content="Finish now" 
                                   Style="{StaticResource HollowButton}"
                                   Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>-->

            <!-- Notifications -->
            <!--<StackPanel x:Name="Notifications" 
                       VerticalAlignment="Top" 
                       HorizontalAlignment="Right"
                       Margin="10"/>-->

            <!-- Hover Window -->
            <!--<Border x:Name="HoverWindow" 
                   Background="#cc000000" 
                   Visibility="Collapsed"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Padding="10"
                   BorderBrush="White"
                   BorderThickness="1">
                <TextBlock x:Name="HoverText" Style="{StaticResource WhiteText}"/>
            </Border>-->

            <!-- Main Body -->
            <TabControl x:Name="Body" Grid.Row="0" Margin="10">
                <!-- Stage Tab -->
                <TabItem Header="Stage">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Subtabs -->
                        <TabControl x:Name="StageSubtabs">
                            <TabItem Header="Structures">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <!-- Resets Section -->
                                        <GroupBox>
                                            <GroupBox.Header>
                                                <TextBlock Style="{StaticResource WhiteText}">Resets</TextBlock>
                                            </GroupBox.Header>
                                            <StackPanel Margin="10">
                                                <!-- End Reset -->
                                                <Border x:Name="Reset2Main" 
                                                       BorderBrush="#9400D3" 
                                                       BorderThickness="1" 
                                                       Padding="10"
                                                       Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource WhiteText}" TextWrapping="Wrap">
                                                            <Run Foreground="#FF4444">End</Run>
                                                            <Run> reset forces the </Run>
                                                            <Run Foreground="#9400D3">Universe</Run>
                                                            <Run> reset, refunds Inflations and resets </Run>
                                                            <Run Foreground="#9400D3">Inflatons</Run>
                                                            <Run> and all </Run>
                                                            <Run Foreground="#9400D3">Universe</Run>
                                                            <Run> types.</Run>
                                                        </TextBlock>
                                                        <Button x:Name="Reset2Button" 
                                                               Content="Missing" 
                                                               Style="{StaticResource HollowButton}"
                                                               HorizontalAlignment="Left"
                                                               Margin="0,10,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Stage Reset -->
                                                <Border x:Name="Reset1Main" 
                                                       BorderBrush="White" 
                                                       BorderThickness="1" 
                                                       Padding="10"
                                                       Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource WhiteText}" TextWrapping="Wrap">
                                                            <Run>Current Stage is </Run>
                                                            <Run x:Name="StageWord" FontWeight="Bold" FontSize="20">Microworld</Run>
                                                            <Run>.&#10;Resets everything Stage related to </Run>
                                                            <Run x:Name="StageRewardNew">gain </Run>
                                                            <Run x:Name="StageReward" Foreground="#44FF44">0</Run>
                                                            <Run Foreground="#44FF44"> Strange quarks</Run>
                                                            <Run x:Name="StageRewardOld">enter higher Stage</Run>
                                                            <Run>.</Run>
                                                        </TextBlock>
                                                        <Button x:Name="Reset1Button" 
                                                               Content="Missing" 
                                                               Style="{StaticResource HollowButton}"
                                                               HorizontalAlignment="Left"
                                                               Margin="0,10,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Basic Reset -->
                                                <Border x:Name="Reset0Main" 
                                                       BorderBrush="White" 
                                                       BorderThickness="1" 
                                                       Padding="10">
                                                    <StackPanel>
                                                        <TextBlock x:Name="Reset0Description" 
                                                                  Style="{StaticResource WhiteText}" 
                                                                  TextWrapping="Wrap"/>
                                                        <Button x:Name="Reset0Button" 
                                                               Content="Missing" 
                                                               Style="{StaticResource HollowButton}"
                                                               HorizontalAlignment="Left"
                                                               Margin="0,10,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- Buildings Section -->
                                        <GroupBox Header="Structures" Margin="0,10,0,0">
                                            <StackPanel Margin="10">
                                                <!-- Special Structures -->
                                                <ItemsControl x:Name="SpecialsList">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="White" 
                                                                   BorderThickness="1" 
                                                                   Padding="10" 
                                                                   Margin="5"
                                                                   ToolTip="{Binding Title}">
                                                                <StackPanel>
                                                                    <Image Source="{Binding ImageSource}" 
                                                                          Width="64" 
                                                                          Height="64"/>
                                                                    <TextBlock Style="{StaticResource WhiteText}" 
                                                                              HorizontalAlignment="Center">
                                                                        <Run Text="{Binding Current}"/>
                                                                        <Run>(+</Run>
                                                                        <Run Text="{Binding Get}"/>
                                                                        <Run>)</Run>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Regular Buildings -->
                                                <ItemsControl x:Name="BuildingsList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="White" 
                                                                   BorderThickness="1" 
                                                                   Padding="10" 
                                                                   Margin="0,5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Image Source="{Binding ImageSource}" 
                                                                          Width="48" 
                                                                          Height="48"/>
                                                                    <StackPanel Grid.Column="1" Margin="10,0">
                                                                        <TextBlock Style="{StaticResource WhiteText}">
                                                                            <Run Text="{Binding Name}"/>
                                                                            <Run>: </Run>
                                                                            <Run Text="{Binding Current}" FontWeight="Bold"/>
                                                                            <Run Foreground="#FFFF00">[</Run>
                                                                            <Run x:Name="BuildingTrue" Foreground="#FFFF00" Text="{Binding TrueCount}"/>
                                                                            <Run Foreground="#FFFF00">]</Run>
                                                                        </TextBlock>
                                                                        <TextBlock Style="{StaticResource WhiteText}">
                                                                            <Run>producing: </Run>
                                                                            <Run Text="{Binding Production}" FontWeight="Bold"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Style="{StaticResource WhiteText}" 
                                                                                  HorizontalAlignment="Center">
                                                                            <Run>x</Run>
                                                                            <Run x:Name="BuyX" Text="{Binding BuyX}"/>
                                                                        </TextBlock>
                                                                        <Button Content="{Binding ButtonText}" 
                                                                               Style="{StaticResource HollowButton}"
                                                                               Margin="0,5,0,0"/>
                                                                        <ToggleButton Content="Auto ON" 
                                                                                     Style="{StaticResource SpecialToggle}"
                                                                                     IsChecked="{Binding AutoEnabled}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Building Toggles -->
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Content="Make all" Style="{StaticResource HollowButton}"/>
                                                    <TextBox x:Name="BuyAnyInput" 
                                                            Width="80" 
                                                            Margin="10,0,0,0"
                                                            Text="1"/>
                                                    <Label VerticalContentAlignment="Center">
                                                        <TextBlock Style="{StaticResource WhiteText}">
                                                            How many Structures
                                                        </TextBlock>
                                                    </Label>
                                                    <TextBox x:Name="AutoWaitInput" 
                                                            Width="80" 
                                                            Margin="10,0,0,0"
                                                            Text="1"/>
                                                    <Label VerticalContentAlignment="Center">
                                                        <TextBlock Style="{StaticResource WhiteText}">
                                                            Auto wait multiplier
                                                        </TextBlock>
                                                    </Label>
                                                    <ToggleButton Content="All ON" 
                                                                 Style="{StaticResource SpecialToggle}"
                                                                 Margin="10,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Advanced">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Challenges -->
                                    <GroupBox Header="Challenges">
                                        <StackPanel>
                                            <ItemsControl x:Name="ChallengesList">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding ImageSource}" 
                                                              Width="64" 
                                                              Height="64"
                                                              Margin="5"
                                                              ToolTip="{Binding Title}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </GroupBox>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ChallengeName" 
                                                      Style="{StaticResource BigWord}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ChallengeActive" 
                                                      Text=", active" 
                                                      Style="{StaticResource GreenText}"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ContentControl x:Name="ChallengeMultiline" Margin="0,10,0,0"/>

                                        <GroupBox Header="Rewards" Margin="0,20,0,0">
                                            <StackPanel>
                                                <ContentControl x:Name="ChallengeRewardsMultiline"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- Stage Info Panel -->
                        <Border Grid.Column="1" 
                               BorderBrush="White" 
                               BorderThickness="1" 
                               Margin="10,0,0,0"
                               Padding="10"
                               VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Stage Information" 
                                          Style="{StaticResource BigWord}"
                                          Margin="0,0,0,10"/>
                                <ContentControl x:Name="StageInfoContent"/>

                                <TextBlock Text="Time Information" 
                                          Style="{StaticResource BigWord}"
                                          Margin="0,20,0,10"/>
                                <ContentControl x:Name="TimeInfoContent"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Upgrade Tab -->
                <TabItem Header="Upgrade">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TabControl x:Name="UpgradeSubtabs">
                            <TabItem Header="Upgrades">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Upgrades" Style="{StaticResource BiggerWord}" Margin="0,0,0,10"/>

                                        <!-- Upgrades Grid -->
                                        <ItemsControl x:Name="UpgradesList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding ImageSource}" 
                                                          Width="64" 
                                                          Height="64"
                                                          Margin="5"
                                                          ToolTip="{Binding Title}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Researches" Style="{StaticResource BigWord}" Margin="0,20,0,10"/>

                                        <!-- Researches -->
                                        <GroupBox Header="Stage Researches" Margin="0,0,0,10">
                                            <ItemsControl x:Name="StageResearchesList">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Margin="5">
                                                            <StackPanel>
                                                                <Image Source="{Binding ImageSource}" 
                                                                      Width="48" 
                                                                      Height="48"/>
                                                                <TextBlock Text="{Binding Name}" 
                                                                          Style="{StaticResource WhiteText}"
                                                                          HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </GroupBox>

                                        <!-- Automatization Researches -->
                                        <GroupBox Header="Automatization Researches">
                                            <ItemsControl x:Name="AutoResearchesList">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Margin="5">
                                                            <StackPanel>
                                                                <Image Source="{Binding ImageSource}" 
                                                                      Width="48" 
                                                                      Height="48"/>
                                                                <TextBlock Text="{Binding Name}" 
                                                                          Style="{StaticResource WhiteText}"
                                                                          HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Elements">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Elements" Style="{StaticResource BiggerWord}" Margin="0,0,0,10"/>

                                        <!-- Elements Grid -->
                                        <ItemsControl x:Name="ElementsList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="9"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding ImageSource}" 
                                                          Width="48" 
                                                          Height="48"
                                                          Margin="2"
                                                          ToolTip="{Binding Title}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>

                        <!-- Description Panel -->
                        <Border Grid.Column="1" 
                               BorderBrush="White" 
                               BorderThickness="1" 
                               Margin="10,0,0,0"
                               Padding="10"
                               VerticalAlignment="Top"
                               MinWidth="250">
                            <StackPanel>
                                <TextBlock Text="Type:" Style="{StaticResource WhiteText}"/>
                                <TextBlock x:Name="UpgradeText" 
                                          Style="{StaticResource WhiteText}"
                                          Margin="0,0,0,10"/>

                                <TextBlock Text="Effect:" Style="{StaticResource WhiteText}"/>
                                <TextBlock x:Name="UpgradeEffect" 
                                          Style="{StaticResource WhiteText}"
                                          Margin="0,0,0,10"/>

                                <TextBlock Text="Next:" Style="{StaticResource WhiteText}"/>
                                <TextBlock x:Name="UpgradeCost" 
                                          Style="{StaticResource WhiteText}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <ToggleButton Content="Hover to create ON" 
                                                 Style="{StaticResource SpecialToggle}"/>
                                    <Button Content="Create all" 
                                           Style="{StaticResource HollowButton}"
                                           Margin="10,0,0,0"/>
                                    <ToggleButton Content="Max create ON" 
                                                 Style="{StaticResource SpecialToggle}"
                                                 Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Strangeness Tab -->
                <TabItem Header="Strangeness">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TabControl x:Name="StrangenessSubtabs">
                            <TabItem Header="Matter"/>
                            <TabItem Header="Milestones"/>
                        </TabControl>

                        <Border Grid.Column="1" 
                               BorderBrush="White" 
                               BorderThickness="1" 
                               Margin="10,0,0,0"
                               Padding="10"
                               VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Strangeness Info" Style="{StaticResource BigWord}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Inflation Tab -->
                <TabItem Header="Inflation">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TabControl x:Name="InflationSubtabs">
                            <TabItem Header="Inflations"/>
                            <TabItem Header="Milestones"/>
                        </TabControl>

                        <Border Grid.Column="1" 
                               BorderBrush="White" 
                               BorderThickness="1" 
                               Margin="10,0,0,0"
                               Padding="10"
                               VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Inflation Info" Style="{StaticResource BigWord}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Settings Tab -->
                <TabItem Header="Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TabControl x:Name="SettingsSubtabs">
                            <TabItem Header="Settings">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Options" Style="{StaticResource BiggerWord}" Margin="0,0,0,10"/>

                                        <StackPanel>
                                            <TextBlock Text="File name:" Style="{StaticResource WhiteText}"/>
                                            <TextBox x:Name="SaveFileNameInput" 
                                                    Text="Fundamental.txt"
                                                    Margin="0,5,0,15"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="Visual numbers update interval:" Style="{StaticResource WhiteText}"/>
                                                <TextBox x:Name="NumbersInterval" 
                                                        Width="60" 
                                                        Text="100"
                                                        Margin="10,0,0,0"/>
                                                <TextBlock Text="ms" Style="{StaticResource WhiteText}" VerticalAlignment="Center"/>
                                                <Button Content="Pause" 
                                                       Style="{StaticResource HollowButton}"
                                                       Margin="20,0,0,0"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="Visual update and events interval:" Style="{StaticResource WhiteText}"/>
                                                <TextBox x:Name="VisualInterval" 
                                                        Width="60" 
                                                        Text="500"
                                                        Margin="10,0,0,0"/>
                                                <TextBlock Text="ms" Style="{StaticResource WhiteText}" VerticalAlignment="Center"/>
                                                <Button Content="Events" 
                                                       Style="{StaticResource HollowButton}"
                                                       Margin="20,0,0,0"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="Game autosave interval:" Style="{StaticResource WhiteText}"/>
                                                <TextBox x:Name="AutoSaveInterval" 
                                                        Width="60" 
                                                        Text="60"
                                                        Margin="10,0,0,0"/>
                                                <TextBlock Text="s" Style="{StaticResource WhiteText}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="Format type:" Style="{StaticResource WhiteText}"/>
                                                <TextBlock Text="point" Style="{StaticResource WhiteText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <TextBox x:Name="DecimalPoint" 
                                                        Width="20" 
                                                        Text="."
                                                        Margin="5,0,0,0"/>
                                                <TextBlock Text="separator" Style="{StaticResource WhiteText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <TextBox x:Name="ThousandSeparator" 
                                                        Width="20" 
                                                        Text=","
                                                        Margin="5,0,0,0"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="Font size:" Style="{StaticResource WhiteText}"/>
                                                <TextBox x:Name="CustomFontSize" 
                                                        Width="60" 
                                                        Text="16"
                                                        Margin="10,0,0,0"/>
                                                <TextBlock Text="px" Style="{StaticResource WhiteText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <GroupBox Header="Other automatization" Margin="0,20,0,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                                    <TextBlock Text="Strangeness" Style="{StaticResource WhiteText}"/>
                                                    <TextBlock Text="⟶" Style="{StaticResource WhiteText}" Margin="10,0"/>
                                                    <ToggleButton Content="Auto OFF" Style="{StaticResource SpecialToggle}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                                    <TextBlock Text="Elements" Style="{StaticResource WhiteText}"/>
                                                    <TextBlock Text="⟶" Style="{StaticResource WhiteText}" Margin="10,0"/>
                                                    <ToggleButton Content="Auto OFF" Style="{StaticResource SpecialToggle}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                                    <TextBlock Text="Upgrades" Style="{StaticResource WhiteText}"/>
                                                    <TextBlock Text="⟶" Style="{StaticResource WhiteText}" Margin="10,0"/>
                                                    <ToggleButton Content="Auto OFF" Style="{StaticResource SpecialToggle}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                                    <TextBlock Text="Stage Researches" Style="{StaticResource WhiteText}"/>
                                                    <TextBlock Text="⟶" Style="{StaticResource WhiteText}" Margin="10,0"/>
                                                    <ToggleButton Content="Auto OFF" Style="{StaticResource SpecialToggle}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                                    <TextBlock Text="Special Researches" Style="{StaticResource WhiteText}"/>
                                                    <TextBlock Text="⟶" Style="{StaticResource WhiteText}" Margin="10,0"/>
                                                    <ToggleButton Content="Auto OFF" Style="{StaticResource SpecialToggle}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="Current theme" Margin="0,20,0,0">
                                            <StackPanel>
                                                <Button x:Name="CurrentTheme" 
                                                       Content="Default" 
                                                       Style="{StaticResource HollowButton}"
                                                       HorizontalAlignment="Left"/>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button Content="Default" Style="{StaticResource HollowButton}"/>
                                                    <Button Content="Microworld" Style="{StaticResource HollowButton}"/>
                                                    <Button Content="Submerged" Style="{StaticResource HollowButton}"/>
                                                    <Button Content="Accretion" Style="{StaticResource HollowButton}"/>
                                                    <Button Content="Interstellar" Style="{StaticResource HollowButton}"/>
                                                    <Button Content="Intergalactic" Style="{StaticResource HollowButton}"/>
                                                    <Button Content="Abyss" Style="{StaticResource HollowButton}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Stats">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Statistics" Style="{StaticResource BiggerWord}" Margin="0,0,0,10"/>

                                        <TextBlock Style="{StaticResource WhiteText}" TextWrapping="Wrap">
                                            <Run>Started playing: </Run>
                                            <Run x:Name="FirstPlay">00.00.0000, 00:00:00</Run>
                                            <Run> (</Run>
                                            <Run x:Name="FirstPlayAgo">0 seconds</Run>
                                            <Run> ago) | Online time: </Run>
                                            <Run x:Name="OnlineTotal">0 seconds</Run>
                                        </TextBlock>

                                        <TextBlock x:Name="ExportStats" 
                                                  Style="{StaticResource WhiteText}"
                                                  TextWrapping="Wrap"
                                                  Margin="0,10,0,0"/>

                                        <GroupBox Header="Structures" Margin="0,20,0,0">
                                            <ItemsControl x:Name="BuildingStatsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="White" 
                                                               BorderThickness="1" 
                                                               Padding="10" 
                                                               Margin="0,5">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" 
                                                                          Style="{StaticResource BigWord}"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                                                    <TextBlock Text="This reset: " Style="{StaticResource WhiteText}"/>
                                                                    <TextBlock Text="{Binding ThisReset}" Style="{StaticResource WhiteText}"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Total: " Style="{StaticResource WhiteText}"/>
                                                                    <TextBlock Text="{Binding Total}" Style="{StaticResource WhiteText}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="History">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="History" Style="{StaticResource BiggerWord}" Margin="0,0,0,10"/>

                                        <GroupBox Header="End resets" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Save:" Style="{StaticResource WhiteText}"/>
                                                    <TextBox Width="50" Margin="5,0,20,0"/>
                                                    <TextBlock Text="show:" Style="{StaticResource WhiteText}"/>
                                                    <TextBox Width="50" Margin="5,0,0,0"/>
                                                </StackPanel>
                                                <ListBox x:Name="EndHistoryList" 
                                                        Height="200" 
                                                        Margin="0,10,0,0"/>
                                                <TextBlock Text="Best reset: " Style="{StaticResource WhiteText}"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="Stage resets">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Save:" Style="{StaticResource WhiteText}"/>
                                                    <TextBox Width="50" Margin="5,0,20,0"/>
                                                    <TextBlock Text="show:" Style="{StaticResource WhiteText}"/>
                                                    <TextBox Width="50" Margin="5,0,0,0"/>
                                                </StackPanel>
                                                <ListBox x:Name="StageHistoryList" 
                                                        Height="200" 
                                                        Margin="0,10,0,0"/>
                                                <TextBlock Text="Best reset: " Style="{StaticResource WhiteText}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>

                        <!-- Save File Group -->
                        <Border Grid.Column="1" 
                               BorderBrush="White" 
                               BorderThickness="1" 
                               Margin="10,0,0,0"
                               Padding="10"
                               VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Save File" Style="{StaticResource BigWord}" Margin="0,0,0,10"/>

                                <TextBlock Text="Please export save file regularly" 
                                          Style="{StaticResource BigWord}"
                                          FontSize="16"
                                          Margin="0,0,0,5"/>
                                <TextBlock x:Name="ExportReward" 
                                          Style="{StaticResource WhiteText}"
                                          Margin="0,0,0,15"/>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="Save" 
                                               Style="{StaticResource HollowButton}"
                                               Width="100"/>
                                        <Button Content="Load" 
                                               Style="{StaticResource HollowButton}"
                                               Width="100"
                                               Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Button Content="Export save file" 
                                           Style="{StaticResource HollowButton}"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,0,0,10"/>
                                    <Button Content="Advanced save options" 
                                           Style="{StaticResource HollowButton}"
                                           HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource WhiteText}" Margin="0,15,0,0">
                                    <Run>Last time saved: </Run>
                                    <Run x:Name="IsSaved">Not in current session</Run>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Footer -->
            <Grid Grid.Row="1" Background="#2a2a2a" Margin="10,10,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Shortcuts -->
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button Content="Exit" Style="{StaticResource HollowButton}"/>
                    <Button Content="Missing" Style="{StaticResource HollowButton}" Margin="10,0,0,0"/>
                    <Button Content="Missing" Style="{StaticResource HollowButton}" Margin="10,0,0,0"/>
                    <Button Content="Stage" Style="{StaticResource HollowButton}" Margin="10,0,0,0"/>
                    <Button Content="End" Style="{StaticResource HollowButton}" Margin="10,0,0,0"/>
                    <Button Content="Upgrades" Style="{StaticResource HollowButton}" Margin="10,0,0,0"/>
                    <Button Content="Structures" Style="{StaticResource HollowButton}" Margin="10,0,0,0"/>
                    <Button Content="Shift" Style="{StaticResource HollowButton}" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Footer Stats -->
                <ItemsControl x:Name="FooterStats" Grid.Column="1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{Binding BorderColor}" 
                                   BorderThickness="1" 
                                   Padding="10" 
                                   Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding ImageSource}" 
                                          Width="32" 
                                          Height="32"
                                          Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" 
                                                  Foreground="{Binding TextColor}"/>
                                        <TextBlock Text="{Binding Value}" 
                                                  Foreground="White"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Tabs Navigation -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10">
                    <Button Content="Stage" Style="{StaticResource HollowButton}"/>
                    <Button Content="Upgrade" Style="{StaticResource HollowButton}" Margin="10,0,0,0"/>
                    <Button Content="Strangeness" Style="{StaticResource HollowButton}" Margin="10,0,0,0"/>
                    <Button Content="Inflation" Style="{StaticResource HollowButton}" Margin="10,0,0,0"/>
                    <Button Content="Settings" Style="{StaticResource HollowButton}" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
