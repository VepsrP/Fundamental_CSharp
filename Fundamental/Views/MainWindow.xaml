<Window x:Class="Fundamental.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Icon="{StaticResource Stage}"
        Title="{Binding Title}" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a">

    <Window.Resources>
        <!-- Styles -->
        <Style x:Key="WhiteText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF4444"/>
        </Style>
        <Style x:Key="GreenText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#44FF44"/>
        </Style>
        <Style x:Key="BlueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4444FF"/>
        </Style>
        <Style x:Key="CyanText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00FFFF"/>
        </Style>
        <Style x:Key="OrangeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFA500"/>
        </Style>
        <Style x:Key="GrayText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
        </Style>
        <Style x:Key="DarkVioletTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9400D3"/>
        </Style>
        <Style x:Key="DarkOrchidTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B266CC"/>
        </Style>
        <Style x:Key="OrchidText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DA70D6"/>
        </Style>
        <Style x:Key="YellowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFF00"/>
        </Style>

        <Style x:Key="BigWord" TargetType="TextBlock" BasedOn="{StaticResource WhiteText}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="BiggerWord" TargetType="TextBlock" BasedOn="{StaticResource WhiteText}">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SpecialToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="HollowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Loading Screen -->
        <Border x:Name="LoadingPanel" Background="#1a1a1a" Visibility="{Binding LoadingPanelVisible}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Fundamental" Style="{StaticResource BiggerWord}" HorizontalAlignment="Center"/>
                <TextBlock Text="Game is loading. If it don't load (after trying to reload at least once), then can try to report it on discord or GitHub" 
                          Style="{StaticResource WhiteText}" 
                          TextWrapping="Wrap" 
                          Margin="0,20,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid x:Name="MainContent" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Global Toggle Button -->
            <ToggleButton x:Name="GlobalToggle0" 
                         Content="OFF" 
                         Style="{StaticResource SpecialToggle}"
                         HorizontalAlignment="Right" 
                         VerticalAlignment="Top"
                         Visibility="Collapsed"/>

            <!-- Big Window Overlay -->
            <!--<Border x:Name="BigWindow" 
                   Background="#80000000" 
                   Visibility="Collapsed"
                   Grid.RowSpan="2">
                <Border BorderBrush="White" BorderThickness="2" Margin="100">
                    <ContentControl x:Name="BigWindowContent"/>
                </Border>
            </Border>-->

            <!-- Alert Dialog -->
            <!--<Border x:Name="AlertMain" 
                   Background="#80000000" 
                   Visibility="Collapsed"
                   Grid.RowSpan="2">
                <Border Background="#2a2a2a" 
                       BorderBrush="White" 
                       BorderThickness="2" 
                       Padding="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MinWidth="400">
                    <StackPanel>
                        <TextBlock x:Name="AlertText" 
                                  Text="Welcome back" 
                                  Style="{StaticResource WhiteText}"
                                  Margin="0,0,0,15"
                                  TextWrapping="Wrap"/>
                        <TextBox x:Name="AlertInput" 
                                Visibility="Collapsed"
                                Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AlertConfirm" 
                                   Content="Confirm" 
                                   Style="{StaticResource HollowButton}"/>
                            <Button x:Name="AlertCancel" 
                                   Content="Cancel" 
                                   Style="{StaticResource HollowButton}"
                                   Visibility="Collapsed"
                                   Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>-->

            <!-- Offline Calculation Dialog -->
            <!--<Border x:Name="OfflineMain" 
                   Background="#80000000" 
                   Visibility="Collapsed"
                   Grid.RowSpan="2">
                <Border Background="#2a2a2a" 
                       BorderBrush="White" 
                       BorderThickness="2" 
                       Padding="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MinWidth="500">
                    <StackPanel>
                        <TextBlock Style="{StaticResource WhiteText}" TextWrapping="Wrap">
                            <Run>Calculating Offline time by using </Run>
                            <Run x:Name="OfflineTick" Text="1"/>
                            <Run> milliseconds per tick. Remains </Run>
                            <Run x:Name="OfflineRemains" Text="0 seconds"/>
                            <Run> to calculate (</Run>
                            <Run x:Name="OfflinePercentage" Text="0% done"/>
                            <Run>)</Run>
                        </TextBlock>
                        <TextBlock Text="Accelerating too much will break time based autos" 
                                  Style="{StaticResource WhiteText}"
                                  Margin="0,10,0,15"/>
